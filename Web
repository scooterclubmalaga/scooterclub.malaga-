<div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label="Foto ampliada">
  <img id="lbImg" alt="">
  <p id="lbCap"></p>
  <div class="lbnav"><button class="btn sm" id="lbP" type="button" aria-label="Foto anterior">&larr;</button><button class="btn sm alt" id="lbX" type="button">Cerrar</button><button class="btn sm" id="lbN" type="button" aria-label="Foto siguiente">&rarr;</button></div>
</div>
<div class="fab"><a class="btn sm" href="https://chat.whatsapp.com/BkM16j2oAlk5Fhy3GLBMaE" target="_blank" rel="noopener">Únete al club</a></div>

<script>
(function(){
"use strict";
var $=function(s){return document.querySelector(s)},$$=function(s){return Array.prototype.slice.call(document.querySelectorAll(s))};
$('#yr').textContent=new Date().getFullYear();

/* aparición al hacer scroll */
var rv=$$('.rv');
if('IntersectionObserver' in window){
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
  rv.forEach(function(el,i){el.style.transitionDelay=(i%3)*.08+'s';io.observe(el)});
}else rv.forEach(function(el){el.classList.add('in')});

/* barra de progreso y enlace activo */
var bar=$('#bar'),links=$$('.nav ul a'),secs=['tablon','grupos','unirse','historia','contacto'].map(function(id){return document.getElementById(id)});
function onScroll(){
  var h=document.documentElement,max=h.scrollHeight-h.clientHeight;
  bar.style.width=(max>0?(h.scrollTop||document.body.scrollTop)/max*100:0)+'%';
  var y=window.scrollY+120,cur=-1;
  secs.forEach(function(s,i){if(s&&s.offsetTop<=y)cur=i});
  links.forEach(function(a,i){a.classList.toggle('on',i===cur)});
}
window.addEventListener('scroll',onScroll,{passive:true});onScroll();

/* tablón de noticias */
var DATA={updated:'',posts:[]};
try{DATA=JSON.parse($('#news-data').textContent)||DATA}catch(e){}
var POSTS=Array.isArray(DATA.posts)?DATA.posts:[];
var TYPES=[
 {k:'quedada',l:'Quedadas',s:'Quedada',c:'var(--lime)',d:'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z M12 7.5v5'},
 {k:'ruta',l:'Rutas',s:'Ruta',c:'var(--cyan)',d:'M4 19C8 19 8 12 12 12S16 5 20 5'},
 {k:'noticia',l:'Noticias',s:'Noticia',c:'var(--violet)',d:'M4 5h16v10H9l-5 4z'},
 {k:'anuncio',l:'Anuncios',s:'Anuncio',c:'var(--pink)',d:'M4 10v4h3l7 4V6l-7 4z M18 9c1.5 1.5 1.5 4.5 0 6'},
 {k:'aviso',l:'Avisos',s:'Aviso',c:'var(--orange)',d:'M12 4l9 15H3z M12 10v4 M12 17v.1'},
 {k:'foto',l:'Fotos',s:'Foto',c:'var(--ink)',d:'M4 8h3l2-3h6l2 3h3v11H4z M12 11.5a3 3 0 1 0 0 6 3 3 0 1 0 0-6'}
];
var TM={};TYPES.forEach(function(t){TM[t.k]=t});
var EMPTY={
 todo:['Todavía no hay nada en el tablón','Vuelve pronto.'],
 quedada:['No hay quedadas nuevas','Cuando haya una, la verás aquí.'],
 ruta:['Aún no hay rutas publicadas','Pronto subiremos rutas para que las sigas.'],
 noticia:['Sin noticias por ahora','Todo lo nuevo del club aparecerá aquí.'],
 anuncio:['Sin anuncios por ahora','Vuelve pronto.'],
 aviso:['Sin avisos por ahora','Todo en orden.'],
 foto:['Aún no hay fotos','Pronto subiremos fotos de las rutas.']
};
function mk(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!==undefined&&x!==null)e.textContent=x;return e}
function svgIcon(d){
  var ns='http://www.w3.org/2000/svg',s=document.createElementNS(ns,'svg'),p=document.createElementNS(ns,'path');
  s.setAttribute('viewBox','0 0 24 24');s.setAttribute('aria-hidden','true');p.setAttribute('d',d);s.appendChild(p);return s;
}
function pd(v){var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(v||'');return m?new Date(+m[1],+m[2]-1,+m[3]):null}
var now0=new Date(),TODAY=new Date(now0.getFullYear(),now0.getMonth(),now0.getDate());
function ago(v){
  var d=pd(v);if(!d)return '';var n=Math.round((TODAY-d)/864e5);
  if(n<=0)return 'Hoy';if(n===1)return 'Ayer';if(n<7)return 'Hace '+n+' días';
  return d.toLocaleDateString('es-ES',{day:'numeric',month:'short'});
}
function isDone(p){var u=pd(p.until||p.on);return !!u&&u<TODAY}
function safeUrl(u){return typeof u==='string'&&(/^https?:\/\//.test(u)||/^#[\w.~-]+$/.test(u))}
function safeImg(u){return typeof u==='string'&&(/^data:image\/(jpeg|png|webp);base64,/.test(u)||/^https:\/\//.test(u))}
var SORTED=POSTS.map(function(p,i){return{p:p,i:i}}).sort(function(a,b){
  var da=isDone(a.p)?1:0,db=isDone(b.p)?1:0;if(da!==db)return da-db;
  var pa=a.p.pinned?0:1,pb=b.p.pinned?0:1;if(pa!==pb)return pa-pb;
  var ka=a.p.date||'',kb=b.p.date||'';if(ka!==kb)return ka<kb?1:-1;
  return a.i-b.i;
}).map(function(x){return x.p});
var filt='todo';

var LB={list:[],i:0,op:null},CDS=[];
function lbShow(){
  var it=LB.list[LB.i];$('#lbImg').src=it.src;$('#lbImg').alt=it.alt||'';$('#lbCap').textContent=it.alt||'';
  var multi=LB.list.length>1;$('#lbP').hidden=!multi;$('#lbN').hidden=!multi;
}
function lightbox(list,i,opener){
  LB.list=list;LB.i=i;LB.op=opener;lbShow();$('#lb').hidden=false;$('#lbX').focus();
}
function lbStep(d){if(LB.list.length>1){LB.i=(LB.i+d+LB.list.length)%LB.list.length;lbShow()}}
function closeLb(){var lb=$('#lb');if(lb.hidden)return;lb.hidden=true;$('#lbImg').removeAttribute('src');if(LB.op)LB.op.focus()}
$('#lbX').addEventListener('click',closeLb);
$('#lbP').addEventListener('click',function(){lbStep(-1)});
$('#lbN').addEventListener('click',function(){lbStep(1)});
$('#lb').addEventListener('click',function(e){if(e.target===this)closeLb()});
document.addEventListener('keydown',function(e){
  if($('#lb').hidden)return;
  if(e.key==='Escape')closeLb();
  if(e.key==='ArrowLeft')lbStep(-1);
  if(e.key==='ArrowRight')lbStep(1);
});
var COLORS={lime:'var(--lime)',cyan:'var(--cyan)',violet:'var(--violet)',pink:'var(--pink)',orange:'var(--orange)',ink:'var(--ink)'};
function tgt(p){
  var d=pd(p.on);if(!d)return null;
  var m=/^(\d{1,2}):(\d{2})$/.exec(p.at||'');if(m)d.setHours(+m[1],+m[2],0,0);
  return d;
}
function cdText(p){
  var t=tgt(p);if(!t)return '';
  if(!/^\d{1,2}:\d{2}$/.test(p.at||'')){
    var n=Math.round((pd(p.on)-TODAY)/864e5);
    return n<=0?'¡Es hoy!':n===1?'Mañana':'Faltan '+n+' días';
  }
  var ms=t-new Date();if(ms<=0)return '¡En marcha!';
  var d=Math.floor(ms/864e5),h=Math.floor(ms%864e5/36e5),mi=Math.floor(ms%36e5/6e4);
  if(d>=1)return 'Faltan '+d+(d===1?' día':' días')+(h?' y '+h+' h':'');
  if(h>=1)return 'Faltan '+h+' h '+mi+' min';
  return 'Faltan '+Math.max(mi,1)+' min';
}
function card(p,i){
  var key=TM[p.type]?p.type:'noticia',T=TM[key],done=isDone(p);
  var a=mk('article','post t-'+key+(p.pinned?' pinned':'')+(done?' done':''));
  a.style.setProperty('--i',Math.min(i,8));
  if(COLORS[p.color])a.style.setProperty('--c',COLORS[p.color]);
  if(p.pinned&&!done)a.appendChild(mk('span','pin','Fijado'));
  if(safeImg(p.photo)){
    var b=mk('button','ph'+(p.fit==='contain'?' contain':''));b.type='button';b.setAttribute('aria-label','Ampliar la foto');
    var im=mk('img');im.src=p.photo;im.alt=p.alt||p.title||'';im.loading='lazy';b.appendChild(im);
    b.addEventListener('click',function(){lightbox([{src:p.photo,alt:p.alt||p.title}],0,b)});
    a.appendChild(b);
  }
  var pics=Array.isArray(p.photos)?p.photos.filter(function(x){return x&&safeImg(x.src)}):[];
  if(pics.length){
    var g=mk('div','album');
    pics.forEach(function(x,k){
      var bt=mk('button','ph');bt.type='button';bt.setAttribute('aria-label','Ampliar la foto '+(k+1)+' de '+pics.length);
      var m2=mk('img');m2.src=x.src;m2.alt=x.alt||'';m2.loading='lazy';bt.appendChild(m2);
      bt.addEventListener('click',function(){lightbox(pics,k,bt)});g.appendChild(bt);
    });
    a.appendChild(g);
  }
  var top=mk('div','pt'),pill=mk('span','tpill');pill.appendChild(svgIcon(T.d));pill.appendChild(document.createTextNode(T.s));
  top.appendChild(pill);top.appendChild(mk('span','ago',done?'Finalizada':ago(p.date)));a.appendChild(top);
  a.appendChild(mk('h3','disp',p.title||''));
  if(p.on&&!done){var c=mk('span','cd',cdText(p));a.appendChild(c);CDS.push({el:c,p:p})}
  if(p.body)a.appendChild(mk('p',null,p.body));
  if(p.when||p.place){var m=mk('div','meta');if(p.when)m.appendChild(mk('span',null,p.when));if(p.place)m.appendChild(mk('span',null,p.place));a.appendChild(m)}
  if(p.link&&safeUrl(p.link.url)){
    var l=mk('a','btn sm',p.link.label||'Ver más');l.href=p.link.url;
    if(/^https?:/.test(p.link.url)){l.target='_blank';l.rel='noopener'}
    a.appendChild(l);
  }
  return a;
}
function renderChips(){
  var box=$('#filters');box.textContent='';
  var all=[{k:'todo',l:'Todo',c:'var(--lime)'}].concat(TYPES);
  all.forEach(function(t){
    var n=t.k==='todo'?SORTED.length:SORTED.filter(function(p){return p.type===t.k}).length;
    var b=mk('button','fchip'+(n?'':' zero'));b.type='button';b.style.setProperty('--c',t.c);
    b.setAttribute('aria-pressed',String(t.k===filt));
    b.appendChild(document.createTextNode(t.l));b.appendChild(mk('i',null,n));
    b.addEventListener('click',function(){filt=t.k;renderChips();renderBoard()});
    box.appendChild(b);
  });
}
function renderBoard(){
  var list=SORTED.filter(function(p){return filt==='todo'||p.type===filt});
  var box=$('#board');box.textContent='';CDS=[];
  list.forEach(function(p,i){box.appendChild(card(p,i))});
  var em=$('#empty');em.hidden=list.length>0;
  if(!list.length){var e=EMPTY[filt]||EMPTY.todo;$('#emptyT').textContent=e[0];$('#emptyP').textContent=e[1]}
}
renderChips();renderBoard();
setInterval(function(){CDS.forEach(function(c){var t=cdText(c.p);if(c.el.textContent!==t)c.el.textContent=t})},30000);
(function(){
  var d=pd(DATA.updated);
  if(d)$('#upd').textContent='Actualizado el '+d.toLocaleDateString('es-ES',{day:'numeric',month:'long'})+'.';
  var nx=SORTED.filter(function(p){return p.type==='quedada'&&!isDone(p)}).sort(function(a,b){return (a.on||'9999')<(b.on||'9999')?-1:1})[0];
  if(nx){
    $('#nextTxt').textContent=(nx.title||'')+(nx.when?' · '+nx.when:'');
    $('#next').classList.add('on');
  }
})();

/* logo que sigue al puntero */
var orbit=$('#orbit'),logo=$('#logo'),reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduce){
  orbit.addEventListener('pointermove',function(e){
    var r=orbit.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
    logo.style.transform='rotateY('+(x*18)+'deg) rotateX('+(-y*18)+'deg) scale(1.03)';
  });
  orbit.addEventListener('pointerleave',function(){logo.style.transform=''});
}

/* copiar contacto */
$('#copy').addEventListener('click',function(){
  var t=$('#mailTxt').textContent,m=$('#msg');
  function ok(){m.textContent='¡Copiado!'}
  function fb(){
    var r=document.createRange();r.selectNodeContents($('#mailTxt'));var s=window.getSelection();s.removeAllRanges();s.addRange(r);
    m.textContent='Selecciónalo y cópialo';
  }
  try{navigator.clipboard.writeText(t).then(ok,fb)}catch(e){fb()}
});
})();
</script>

