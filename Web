<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="description" content="Scooterclub Málaga: la comunidad de riders de Málaga. Quedadas, rutas y novedades."><style>:root{color-scheme:dark}body{margin:0}[hidden]{display:none!important}img{max-width:100%}</style>
<title>Scooterclub Málaga</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,700;1,800;1,900&family=Outfit:wght@400;500;600&family=Permanent+Marker&display=swap">
<style>
/* Layout: portada con titular gigante y logo en órbita; tablón de noticias filtrable alimentado por datos; grupos en mosaico colorido con ilustraciones animadas; historia en panel lima. Calle, asfalto y neón. */
:root{
  --bg:#0e0e10; --card:#17171a; --line:#2a2a30; --ink:#f6f6f1; --mute:#a7a7ae;
  --lime:#c9ff3b; --pink:#ff3d8b; --cyan:#35d6ff; --orange:#ff8a1f; --violet:#a47bff; --black:#0e0e10;
  --display:"Archivo","Arial Black",Impact,sans-serif;
  --body:"Outfit","Helvetica Neue",Arial,sans-serif;
  --marker:"Permanent Marker","Comic Sans MS",cursive;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--ink);font:400 17px/1.55 var(--body);
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  overflow-x:hidden;
}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:40}
a{color:inherit}
:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
.wrap{max-width:1160px;margin:0 auto}
.disp{font-family:var(--display);font-style:italic;font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:.95}
.rv{transform:translateY(16px) rotate(1deg);transition:transform .75s cubic-bezier(.2,.9,.2,1)}
.rv.in{transform:none}

/* cabecera */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;display:flex;align-items:center;gap:18px;padding:10px 0;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav .brand{display:flex;align-items:center;gap:10px;text-decoration:none;margin-right:auto}
.nav .brand img{width:44px;height:44px;border-radius:50%;display:block}
.nav .brand span{font-size:20px}
.nav ul{display:flex;gap:6px;list-style:none;margin:0;padding:0}
.nav ul a{display:block;padding:9px 14px;border-radius:999px;text-decoration:none;font:600 14px var(--body);color:var(--mute);transition:background .2s,color .2s}
.nav ul a:hover,.nav ul a.on{background:var(--ink);color:var(--black)}
@media (max-width:820px){.nav ul{display:none}}
.bar{position:absolute;left:0;bottom:-1px;height:3px;width:0;background:linear-gradient(90deg,var(--lime),var(--cyan),var(--pink));transition:width .1s linear}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font:800 15px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.02em;text-decoration:none;padding:16px 24px;min-height:50px;border:3px solid var(--black);border-radius:14px;background:var(--lime);color:var(--black);cursor:pointer;box-shadow:5px 5px 0 var(--ink);transition:transform .15s,box-shadow .15s}
.btn:hover{transform:translate(-2px,-2px);box-shadow:7px 7px 0 var(--ink)}
.btn:active{transform:translate(3px,3px);box-shadow:2px 2px 0 var(--ink)}
.btn.alt{background:var(--ink)}
.btn.sm{padding:11px 16px;min-height:42px;font-size:13px;box-shadow:3px 3px 0 var(--ink)}
.btn svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}

/* portada */
.hero{position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:30px;align-items:center;padding:54px 0 40px}
@media (max-width:900px){.hero{grid-template-columns:minmax(0,1fr);padding-top:34px}}
.hero::before{content:"";position:absolute;inset:-20px -16px 0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:56px 56px;opacity:.35;mask-image:radial-gradient(ellipse at 60% 40%,#000 20%,transparent 72%);-webkit-mask-image:radial-gradient(ellipse at 60% 40%,#000 20%,transparent 72%);pointer-events:none}
.hero>*{position:relative}
.kick{display:inline-block;font:800 14px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.14em;background:var(--pink);color:var(--black);padding:8px 12px;transform:rotate(-2deg);box-shadow:4px 4px 0 var(--ink)}
h1{margin:20px 0 0;font-size:clamp(42px,8.2vw,98px)}
h1 em{font-style:italic;color:var(--lime);position:relative;display:inline-block}
h1 em svg{position:absolute;left:-2%;bottom:-.12em;width:104%;height:.3em;overflow:visible}
h1 em path{fill:none;stroke:var(--pink);stroke-width:9;stroke-linecap:round;stroke-dasharray:420;stroke-dashoffset:420;animation:draw 1.1s .5s cubic-bezier(.6,0,.2,1) forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.sub{margin:22px 0 0;max-width:34em;font-size:clamp(17px,2.2vw,21px);color:var(--ink)}
.cyc{margin-top:20px;display:flex;flex-wrap:wrap;align-items:center;gap:12px;font:800 clamp(20px,3.2vw,30px)/1.2 var(--display);font-style:italic;text-transform:uppercase}
.cyc .win{display:inline-block;height:1.2em;overflow:hidden;color:var(--black);background:var(--cyan);padding:0 12px;border-radius:8px;transform:rotate(-1.5deg)}
.cyc .lst{display:flex;flex-direction:column;animation:cyc 10s cubic-bezier(.7,0,.3,1) infinite}
.cyc .lst span{height:1.2em;line-height:1.2em;white-space:nowrap}
@keyframes cyc{0%,17%{transform:translateY(0)}20%,37%{transform:translateY(-1.2em)}40%,57%{transform:translateY(-2.4em)}60%,77%{transform:translateY(-3.6em)}80%,100%{transform:translateY(-4.8em)}}
.cta{display:flex;flex-wrap:wrap;gap:16px;margin-top:30px}
.soc{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.chip{display:inline-flex;align-items:center;gap:9px;padding:10px 16px 10px 12px;min-height:44px;border:2px solid var(--line);border-radius:999px;text-decoration:none;font:600 15px var(--body);background:var(--card);transition:border-color .2s,transform .2s}
.chip:hover{border-color:var(--lime);transform:translateY(-2px)}
.chip svg{width:20px;height:20px;fill:none;stroke:var(--lime);stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.orbit{position:relative;width:min(86vw,470px);aspect-ratio:1;margin:0 auto;perspective:900px}
.orbit .glow{position:absolute;inset:8%;border-radius:50%;background:radial-gradient(circle,rgba(201,255,59,.45),rgba(201,255,59,0) 68%);animation:glow 3s ease-in-out infinite}
@keyframes glow{0%,100%{transform:scale(.9);opacity:.7}50%{transform:scale(1.12);opacity:1}}
.orbit svg.ring{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.ring .r1{transform-origin:200px 200px;animation:rot 26s linear infinite}
.ring .r2{transform-origin:200px 200px;animation:rot 18s linear infinite reverse}
@keyframes rot{to{transform:rotate(360deg)}}
.logo{position:absolute;inset:7%;transition:transform .2s ease-out;animation:bob 5s ease-in-out infinite}
.logo img{display:block;width:100%;height:100%;object-fit:cover;clip-path:circle(47.5% at 50.7% 49.4%)}
@keyframes bob{0%,100%{translate:0 0;rotate:0deg}50%{translate:0 -10px;rotate:2deg}}
.stk{position:absolute;width:15%;animation:fl 4s ease-in-out infinite}
.stk svg{display:block;width:100%;height:auto;overflow:visible}
.stk.a{left:-2%;top:12%}.stk.b{right:-1%;top:6%;animation-delay:-1s}.stk.c{right:2%;bottom:10%;animation-delay:-2s}.stk.d{left:2%;bottom:8%;animation-delay:-3s}
@keyframes fl{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-14px) rotate(8deg)}}

/* cintas */
.tapes{position:relative;height:150px;margin:14px -16px 0;overflow:hidden}
.tape{position:absolute;left:-5%;right:-5%;white-space:nowrap;overflow:hidden;padding:12px 0;font:900 22px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.04em;color:var(--black)}
.tape div{display:inline-block;animation:tp 22s linear infinite}
.tape.t1{top:30px;background:var(--lime);transform:rotate(-2.2deg)}
.tape.t2{top:64px;background:var(--pink);transform:rotate(1.6deg)}
.tape.t2 div{animation-direction:reverse;animation-duration:26s}
@keyframes tp{to{transform:translateX(-50%)}}

/* secciones */
section.s{padding:84px 0 0;scroll-margin-top:70px}
.head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px}
.tag{display:inline-block;font:800 13px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.16em;padding:7px 11px;background:var(--cyan);color:var(--black);transform:rotate(-2deg)}
h2{margin:14px 0 0;font-size:clamp(34px,6vw,68px)}
.lead{margin:14px 0 0;max-width:36em;color:var(--mute)}
.filters{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.fchip{--c:var(--lime);display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 14px 8px 16px;border:3px solid var(--ink);border-radius:999px;background:transparent;color:var(--ink);font:800 14px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.04em;cursor:pointer;transition:transform .15s,background .15s,color .15s}
.fchip i{font:700 12px/1 var(--body);font-style:normal;min-width:22px;height:22px;border-radius:11px;display:grid;place-items:center;background:var(--ink);color:var(--black);padding:0 6px}
.fchip:hover{transform:translateY(-2px) rotate(-1deg)}
.fchip[aria-pressed="true"]{background:var(--c);color:var(--black);border-color:var(--black);box-shadow:4px 4px 0 var(--ink)}
.fchip[aria-pressed="true"] i{background:var(--black);color:var(--ink)}
.fchip.zero{opacity:.55}
.board{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,310px),1fr));gap:24px;margin-top:32px;align-items:start}
.post{--c:var(--lime);position:relative;display:flex;flex-direction:column;gap:12px;min-width:0;background:var(--c);color:var(--black);border:3px solid var(--black);border-radius:24px;padding:22px;box-shadow:8px 8px 0 rgba(246,246,241,.9);animation:pop .6s cubic-bezier(.2,.9,.2,1) backwards;animation-delay:calc(var(--i,0) * 70ms);transition:transform .25s cubic-bezier(.2,.9,.2,1),box-shadow .25s}
.post:hover{transform:translate(-3px,-5px) rotate(-.5deg);box-shadow:12px 13px 0 rgba(246,246,241,.9)}
@keyframes pop{from{transform:translateY(28px) rotate(1.5deg) scale(.97)}to{transform:none}}
.t-quedada{--c:var(--lime)}.t-ruta{--c:var(--cyan)}.t-noticia{--c:var(--violet)}.t-anuncio{--c:var(--pink)}.t-aviso{--c:var(--orange)}.t-foto{--c:var(--ink)}
.post.pinned{grid-column:1/-1;padding:clamp(22px,4vw,36px);gap:14px}
.post.pinned h3{font-size:clamp(34px,6.4vw,64px)}
.post.pinned p{font-size:clamp(17px,2.2vw,20px);max-width:36em}
.post.done{filter:saturate(.3);opacity:.78}
.post h3{margin:0;font-size:clamp(26px,3.6vw,34px);overflow-wrap:anywhere}
.post p{margin:0;font-weight:500;font-size:17px}
.pt{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.tpill{display:inline-flex;align-items:center;gap:7px;font:800 12px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.12em;padding:7px 11px;border-radius:999px;background:var(--black);color:var(--ink)}
.tpill svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.ago{font:700 13px var(--body)}
.meta{display:flex;flex-wrap:wrap;gap:8px}
.meta span{font:700 14px var(--body);border:2px solid var(--black);border-radius:999px;padding:6px 12px}
.ph{display:block;width:100%;padding:0;border:3px solid var(--black);border-radius:16px;overflow:hidden;background:var(--black);cursor:zoom-in;aspect-ratio:4/3}
.ph img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.ph:hover img{transform:scale(1.06)}
.post.pinned .ph{aspect-ratio:16/9;max-height:380px}
.pin{position:absolute;right:-8px;top:-14px;z-index:2;background:var(--black);color:var(--lime);border:3px solid var(--lime);font:900 13px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.1em;padding:8px 14px;transform:rotate(8deg);animation:wob 1.8s ease-in-out infinite}
.post .btn{align-self:flex-start}
.album{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.album .ph{aspect-ratio:1}
.post.pinned .album{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:640px){.post.pinned .album{grid-template-columns:repeat(2,minmax(0,1fr))}}
.ph.contain img{object-fit:contain}
.post.pinned .ph.contain{aspect-ratio:1;max-height:420px}
.cd{display:inline-flex;align-items:center;gap:10px;align-self:flex-start;font:900 15px/1 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.04em;background:var(--black);color:var(--ink);padding:10px 14px;border-radius:12px}
.cd::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--lime);flex:none;animation:ping 1.6s ease-out infinite}
.post.pinned .cd{font-size:clamp(16px,3.2vw,24px);padding:12px 18px}
.lbnav{display:flex;gap:10px}
.lb [hidden]{display:none}
.empty{margin:30px 0 0;display:flex;flex-direction:column;align-items:center;gap:12px;padding:34px 16px;border:3px dashed var(--line);border-radius:24px;text-align:center;color:var(--mute)}
.empty[hidden]{display:none}
.empty svg{width:72px;height:72px;overflow:visible}
.empty strong{font:900 22px/1.1 var(--display);font-style:italic;text-transform:uppercase;color:var(--ink)}
.empty p{margin:0}
.next{display:none;margin-top:22px;align-items:center;gap:14px;padding:10px 18px 10px 16px;border:3px solid var(--lime);border-radius:16px;text-decoration:none;max-width:100%;transition:transform .2s}
.next.on{display:inline-flex}
.next:hover{transform:translateY(-2px) rotate(-.5deg)}
.next .dot{width:12px;height:12px;border-radius:50%;background:var(--lime);flex:none;animation:ping 1.6s ease-out infinite}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(201,255,59,.7)}100%{box-shadow:0 0 0 14px rgba(201,255,59,0)}}
.next b{display:block;font:900 12px/1.2 var(--display);font-style:italic;text-transform:uppercase;letter-spacing:.14em;color:var(--lime)}
.next span{font:600 16px/1.3 var(--body)}
.lb{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.9);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:max(16px,env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) max(16px,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.lb[hidden]{display:none}
.lb img{max-width:100%;max-height:78vh;border-radius:14px;border:3px solid var(--ink);display:block}
.lb p{margin:0;color:var(--ink);font-weight:500;text-align:center;max-width:40em}
.px rect{animation:pxu 3s ease-in infinite}
.px rect:nth-child(2){animation-delay:-1s}.px rect:nth-child(3){animation-delay:-2s}.px rect:nth-child(4){animation-delay:-.5s}
@keyframes pxu{0%{transform:translateY(20px);opacity:0}20%{opacity:1}100%{transform:translateY(-46px);opacity:0}}

/* grupos */
.grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:20px;margin-top:38px}
.g{grid-column:span 2;position:relative;display:flex;flex-direction:column;border:3px solid var(--black);border-radius:26px;overflow:hidden;color:var(--black);background:var(--c);box-shadow:8px 8px 0 rgba(246,246,241,.9);transition:transform .25s cubic-bezier(.2,.9,.2,1),box-shadow .25s}
.g:hover{transform:translate(-4px,-6px) rotate(-.6deg);box-shadow:13px 14px 0 rgba(246,246,241,.9)}
.g.w3{grid-column:span 3}
@media (max-width:980px){.g,.g.w3{grid-column:span 3}.g:last-child{grid-column:span 6}}
@media (max-width:640px){.g,.g.w3,.g:last-child{grid-column:span 6}}
.g .art{height:170px;display:grid;place-items:center;background:rgba(255,255,255,.28);border-bottom:3px solid var(--black)}
.g .art svg{height:100%;width:auto;max-width:100%;overflow:visible}
.g .bd{display:flex;flex-direction:column;gap:10px;padding:20px 22px 22px;flex:1}
.g h3{margin:0;font-size:clamp(28px,3.4vw,38px)}
.g p{margin:0;font-weight:500;font-size:16.5px}
.g .go{margin-top:auto;padding-top:6px;font:900 15px/1 var(--display);font-style:italic;text-transform:uppercase;text-decoration:none;display:inline-flex;align-items:center;gap:8px}
.g .go svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}
.g:hover .go svg{transform:translateX(6px)}
.g .no{position:absolute;left:12px;top:12px;width:36px;height:36px;border-radius:50%;background:var(--black);color:var(--ink);display:grid;place-items:center;font:900 16px var(--display);font-style:italic;z-index:2}
.sticker{position:absolute;right:12px;top:14px;z-index:2;background:var(--lime);color:var(--black);border:3px solid var(--black);font:900 15px/1 var(--display);font-style:italic;letter-spacing:.08em;padding:9px 18px;transform:rotate(12deg);animation:wob 1.8s ease-in-out infinite}
@keyframes wob{0%,100%{transform:rotate(10deg) scale(1)}50%{transform:rotate(16deg) scale(1.12)}}
.b{transform-box:fill-box;transform-origin:50% 100%;animation:bp 6s ease-out infinite}
.b2{animation-delay:.9s}.b3{animation-delay:1.8s}
@keyframes bp{0%{transform:scale(0)}6%{transform:scale(1.1)}10%,86%{transform:scale(1)}95%,100%{transform:scale(0)}}
.dt{animation:dtb .9s ease-in-out infinite}
.dt.d2{animation-delay:.15s}.dt.d3{animation-delay:.3s}
@keyframes dtb{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.bell{transform-origin:120px 22px;animation:ring 3s ease-in-out infinite}
@keyframes ring{0%,40%,100%{transform:rotate(0)}6%{transform:rotate(16deg)}12%{transform:rotate(-14deg)}18%{transform:rotate(10deg)}24%{transform:rotate(-7deg)}30%{transform:rotate(3deg)}}
.rip{transform-box:fill-box;transform-origin:center;animation:rp 3s ease-out infinite;opacity:0}
.rip.r2{animation-delay:.5s}
@keyframes rp{0%{transform:scale(.5);opacity:.6}100%{transform:scale(1.7);opacity:0}}
.badge{transform-box:fill-box;transform-origin:center;animation:bg 1.4s ease-in-out infinite}
@keyframes bg{0%,100%{transform:scale(1)}50%{transform:scale(1.22)}}
.pad{animation:padf 3s ease-in-out infinite;transform-origin:120px 80px}
@keyframes padf{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-8px) rotate(3deg)}}
.bt{animation:btn 1.2s steps(2) infinite}
.bt.b2{animation-delay:.3s}.bt.b3{animation-delay:.6s}.bt.b4{animation-delay:.9s}
@keyframes btn{50%{opacity:.3}}
.sp{transform-origin:center;transform-box:fill-box;animation:rot 1.4s linear infinite}
.sp2{animation-duration:1.4s}
.bike{animation:bk .5s ease-in-out infinite}
@keyframes bk{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
.rd{stroke-dasharray:14 12;animation:rdm .5s linear infinite}
@keyframes rdm{to{stroke-dashoffset:-26}}
.tg{transform-origin:120px 0;animation:sw 2.6s ease-in-out infinite}
@keyframes sw{0%,100%{transform:rotate(9deg)}50%{transform:rotate(-9deg)}}
.svt{font-family:var(--display);font-style:italic;font-weight:900;text-transform:uppercase}

/* pasos */
.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:38px;counter-reset:s}
@media (max-width:820px){.steps{grid-template-columns:minmax(0,1fr)}}
.step{position:relative;border:3px solid var(--line);border-radius:22px;padding:26px 22px;background:var(--card);transition:border-color .25s,transform .25s}
.step:hover{border-color:var(--lime);transform:translateY(-4px)}
.step b{display:block;font:900 64px/1 var(--display);font-style:italic;color:transparent;-webkit-text-stroke:2px var(--lime);margin-bottom:10px;transition:color .25s}
.step:hover b{color:var(--lime)}
.step h3{margin:0 0 6px;font-size:26px}
.step p{margin:0;color:var(--mute)}

/* historia */
.story{margin-top:84px;background:var(--lime);color:var(--black);border:3px solid var(--black);border-radius:30px;box-shadow:10px 10px 0 var(--ink);padding:clamp(24px,5vw,56px);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:34px;align-items:center;scroll-margin-top:70px;overflow:hidden}
@media (max-width:860px){.story{grid-template-columns:minmax(0,1fr)}}
.story h2{margin-top:12px}
.story .tag{background:var(--black);color:var(--lime)}
.story p{font-size:clamp(17px,2.1vw,20px);font-weight:500;margin:18px 0 0;max-width:34em}
